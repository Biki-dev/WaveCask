{
    "manifest_version": 3,
    "name": "WaveCask Tracker",
    "version": "1.0.0",
    "description": "Tracks YouTube video events and logs to console.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content_script.js"
            ],
            "run_at": "document_end"
        }
    ]
}