# Database configuration for local development outside docker-compose
# When using docker-compose, these are overridden by the docker-compose.yml environment variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_events

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_events


# YouTube Data API v3 key (required for Layer 2 classification)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Mount this file into the container and set the path accordingly.
# Example: /app/models/music_classifier.pth
MODEL_PATH=/app/models/music_classifier.pth

# Metadata enrichment providers order of preference
METADATA_PROVIDERS=gemini,openrouter,fallback

# API keys for metadata enrichment providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Model names for metadata enrichment providers
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash